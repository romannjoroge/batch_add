<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_form_batch_import" model="ir.ui.view">
        <field name="name">stock.picking.form.batch.import</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Create a control row (if missing) with a native Add a line button + our button -->
            <xpath expr="//field[@name='move_ids']/list/control" position="inside">
                <button name="action_open_batch_import_wizard"
                        type="object"
                        string="Batch Add (CSV)"
                        class="btn btn-link"
                        context="{'active_model': 'stock.picking', 'active_id': parent.id}"
                        invisible="state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>
</odoo>

