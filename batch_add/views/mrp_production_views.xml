<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_form_batch_import" model="ir.ui.view">
        <field name="name">mrp.production.form.batch.import</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='components']/field[@name='move_raw_ids']/tree" position="inside">
                <control>
                    <create string="Add a line"/>
                    <button name="action_open_batch_import_wizard"
                            type="object"
                            string="Batch Add (CSV)"
                            class="btn btn-link"
                            context="{'active_model': 'mrp.production', 'active_id': parent.id}"
                            invisible="parent.state in ('done', 'cancel')"/>
                </control>
            </xpath>
        </field>
    </record>
</odoo>

